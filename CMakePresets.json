{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (static library)",
      "description": "Apple clang on Apple Silicon. GpuApi is excluded: it wraps Direct3D 12 and has no macOS counterpart.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "RED4EXT_HEADER_ONLY": "OFF",
        "RED4EXT_BUILD_GPUAPI": "OFF",
        "RED4EXT_INSTALL": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64-header-only",
      "inherits": "macos-arm64",
      "displayName": "macOS arm64 (header only)",
      "binaryDir": "${sourceDir}/build/macos-arm64-header-only",
      "cacheVariables": {
        "RED4EXT_HEADER_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64"
    },
    {
      "name": "macos-arm64-header-only",
      "configurePreset": "macos-arm64-header-only"
    }
  ]
}
